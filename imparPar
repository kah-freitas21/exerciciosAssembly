.data 
	msg1: .asciiz "\nDigite um número: "
	msg2: .asciiz "\nO resultado e: "
	
.text
.global main
main:
	li $v0, 4
	la $a0, msg1
	syscall
	
	li $v0, 5
	syscall
	move $t0, $v0
	
	 li $t1, 2
    	rem $t3, $t0, $t1

    	beq $t3, $zero, par
    	j impar

	par:

    	addi $t0, $t0, 5
    	j mostrar

	impar:

    	addi $t0, $t0, 8

	mostrar:

    	li $v0, 4
    	la $a0, msg2
    	syscall


    	li $v0, 1
    	move $a0, $t0
    	syscall


    	li $v0, 10
    	syscall