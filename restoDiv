
.data
    msg1: .asciiz "\nDigite o primeiro numero: "
    msg2: .asciiz "\nDigite o segundo numero: "
    msg3: .asciiz "\nO resto da divisao e: "
    msg4: .asciiz "\nNao e permitido dividir por zero!"

.text
.globl main

main:
    # Ler o primeiro numero
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    # Ler o segundo numero
    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 5
    syscall
    move $t1, $v0

    # Verificar se algum numero e zero
    beq $t0, $zero, divisao_zero
    beq $t1, $zero, divisao_zero

    # Verificar qual numero e maior
    bgt $t0, $t1, dividir

    # Trocar os valores se B for maior que A
    move $t2, $t0
    move $t0, $t1
    move $t1, $t2

dividir:
    # Dividir o maior pelo menor
    div $t0, $t1
    mflo $t2

    # Multiplicar quociente pelo menor
    mul $t3, $t2, $t1

    # Calcular o resto
    sub $t4, $t0, $t3

    # Mostrar o resultado
    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 1
    move $a0, $t4
    syscall

    j encerrar

divisao_zero:
    li $v0, 4
    la $a0, msg4
    syscall

encerrar:
    li $v0, 10
    syscall
