.data
    msg1: .asciiz "\nDigite a altura em cm: "
    msg2: .asciiz "\nMenor altura: "
    msg3: .asciiz "\nMaior altura: "

.text
.globl main

main:
    # Ler a primeira altura
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    # Inicializar menor e maior com a primeira altura
    move $t1, $t0
    move $t2, $t0

    # Contador: ja lemos 1 pessoa
    li $t3, 1

ler:
    # Verificar se ja lemos 15 pessoas
    beq $t3, 15, mostrar

    # Ler a proxima altura
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    # Verificar se e menor que a menor altura
    blt $t0, $t1, atualizar_menor

continuar:
    # Verificar se e maior que a maior altura
    bgt $t0, $t2, atualizar_maior

voltar:
    addi $t3, $t3, 1
    j ler

atualizar_menor:
    move $t1, $t0
    j continuar

atualizar_maior:
    move $t2, $t0
    j voltar

mostrar:
    # Mostrar a menor altura
    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 1
    move $a0, $t1
    syscall

    # Mostrar a maior altura
    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 1
    move $a0, $t2
    syscall

    # Encerrar
    li $v0, 10
    syscall
