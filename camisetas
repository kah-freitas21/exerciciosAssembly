.data
	msg1: .asciiz "\nDigite a quantidade de camisetas pequenas: "
	msg2: .asciiz "\nDigite a quantidade de camisetas médias: "
	msg3: .asciiz "\nDigite a quantidade de camisetas grandes: "
	msg4: .asciiz "\nO valor total arrecadado foi de: "
	
.text
.global main
main:
	li $v0, 4
    	la $a0, msg1
    	syscall

    	li $v0, 5
    	syscall
    	move $t0, $v0

	li $v0, 4
	la $a0, msg2
	syscall
	
	li $v0, 5
	syscall
	move $t1, $v0
	
	li $v0, 4
	la $a0, msg3
	syscall
	
	li $v0, 5
	syscall
	move $t2, $v0
	
	li $t3, 10
	li $t4, 12
	li $t5, 15
	
	mul $t6, $t0, $t3
	mul $t7, $t1, $t4
	mul $t8, $t2, $t5
	
	add $t9,$t6,$t7
	add $t6, $t9, $t8 
	
	li $v0, 4
        la $a0, msg4
    	syscall

	li $v0, 1
        move $a0, $t6
    	syscall

    	li $v0, 10
    	syscall