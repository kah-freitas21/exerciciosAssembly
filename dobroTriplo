
.data
    msg1: .asciiz "\nDigite um numero: "
    msg2: .asciiz "\nResultado: "

.text
.globl main

main:

    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0


    bltz $t0, negativo

positivo:

    li $t1, 2
    mul $t2, $t0, $t1
    j mostrar

negativo:

    li $t1, 3
    mul $t2, $t0, $t1

mostrar:

    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 1
    move $a0, $t2
    syscall

    li $v0, 10
    syscall

	